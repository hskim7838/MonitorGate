<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MonitorGate</RootNamespace>
    <AssemblyName>MonitorGate</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>5</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize Condition=" '$(Configuration)' == 'Release' ">true</Optimize>
    <DebugType Condition=" '$(Configuration)' == 'Debug' ">full</DebugType>
    <ApplicationManifest>MonitorGate.manifest</ApplicationManifest>
    <AppConfig>MonitorGate.exe.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="MonitorGate.cs" />
    <Compile Include="StartupSettings.cs" />
    <Compile Include="SettingsDialog.cs" />
    <Compile Include="OverlayAppearance.cs" />
    <None Include="MonitorGate.manifest" />
    <None Include="MonitorGate.exe.config" />
    <None Include="README.md" />
    <None Include="README.ko.md" />
    <None Include="Build.ps1" />
    <None Include="Verify.ps1" />
    <None Include="Tests.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
</Project>
